{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DM Companion",
  "version": "0.5.17",
  "identifier": "be.digitalejungle.dmcompanion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "DM Companion",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/rules/img/**",
            "$APPDATA/characters/*.avatar.*",
            "$APPDATA/campaigns/*/characters/*.avatar.*",
            "$APPDATA/archived-campaigns/*/characters/*.avatar.*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
